#!/bin/sh

umask 077
set -f

usage() {
	cat <<'EOF'
sec-store-fzf
    interactive fzf interface for sec-store

usage:
    sec-store-fzf [prefix]
    sec store fzf [prefix]

keys:
    Ctrl-i   copy first decrypted line to clipboard
    Ctrl-u   copy entry name to clipboard
    Ctrl-y   copy full decrypted entry to clipboard
    Ctrl-o   generate and copy TOTP to clipboard (requires sec-store-otp)
    Ctrl-v   view full decrypted entry
    Ctrl-e   edit entry
    Ctrl-h   show effective recipient policy
    Ctrl-r   rekey entry
    Ctrl-d   remove entry (with confirmation)
    Ctrl-a   create/edit a new entry

    Ctrl-j, Ctrl-k, Ctrl-n and Ctrl-p are left to fzf navigation.

env vars:
    SEC_STORE_FZF_SEC          sec executable (default: sec)
    SEC_STORE_FZF_FZF          fzf executable (default: fzf)
    SEC_STORE_FZF_CLIP_CMD     custom shell command reading clipboard data on stdin
    SEC_STORE_FZF_PAGER        custom pager command for Ctrl-v (default: less -R)
    SEC_STORE_FZF_PASTE_ONCE   if 1 and wl-copy is used, use --paste-once
    SEC_STORE_FZF_DEBUG        enable debug messages

sec-store configuration continues to use SEC_STORE_* variables.
EOF
}

_name() { basename "$0"; }
_error() { printf '%s: error: %s\n' "$(_name)" "$1" >&2; return 1; }
_info() { printf '%s: %s\n' "$(_name)" "$1" >&2; }
_debug() {
	[ -n "${SEC_STORE_FZF_DEBUG:-}" ] &&
		printf '%s: debug: %s\n' "$(_name)" "$1" >&2
	return 0
}

_sec() {
	printf '%s\n' "${SEC_STORE_FZF_SEC:-sec}"
}

_fzf() {
	printf '%s\n' "${SEC_STORE_FZF_FZF:-fzf}"
}

_store() {
	"$( _sec )" store "$@"
}

_require_sec() {
	command -v "$( _sec )" >/dev/null 2>&1 || {
		_error "sec executable [$( _sec )] not found"
		return 1
	}
}

_require_commands() {
	_require_sec || return 1
	command -v "$( _fzf )" >/dev/null 2>&1 || {
		_error "fzf executable [$( _fzf )] not found"
		return 1
	}
}

_runtime_dir() {
	for d in "${XDG_RUNTIME_DIR:-}" /dev/shm "${TMPDIR:-/tmp}"; do
		[ -n "$d" ] && [ -d "$d" ] && [ -w "$d" ] && {
			printf '%s\n' "$d"
			return 0
		}
	done
	return 1
}

_tmpfile() {
	d=$(_runtime_dir) || return 1
	mktemp "$d/sec-store-fzf.XXXXXX"
}

_tmpdir() {
	d=$(_runtime_dir) || return 1
	mktemp -d "$d/sec-store-fzf.XXXXXX"
}

_clip() {
	if [ -n "${SEC_STORE_FZF_CLIP_CMD:-}" ]; then
		sh -c "$SEC_STORE_FZF_CLIP_CMD"
		return
	fi

	if command -v wl-copy >/dev/null 2>&1; then
		if [ "${SEC_STORE_FZF_PASTE_ONCE:-0}" = 1 ]; then
			wl-copy --paste-once
		else
			wl-copy
		fi
	elif command -v xclip >/dev/null 2>&1; then
		xclip -selection clipboard
	elif command -v xsel >/dev/null 2>&1; then
		xsel --clipboard --input
	else
		_error 'no clipboard command found; set SEC_STORE_FZF_CLIP_CMD'
		return 1
	fi
}

_pager() {
	if [ -n "${SEC_STORE_FZF_PAGER:-}" ]; then
		sh -c "$SEC_STORE_FZF_PAGER"
	elif command -v less >/dev/null 2>&1; then
		LESSHISTFILE=- less -R
	else
		cat
	fi
}

_copy_name() {
	name=$1
	printf '%s' "$name" | _clip || return 1
	_info "entry name copied: [$name]"
}

_copy_first_line() (
	name=$1
	dir=$(_tmpdir) || {
		_error 'cannot create temporary clipboard directory'
		exit 1
	}
	plain=$dir/plain
	first=$dir/first
	mkfifo "$plain" "$first" || {
		rm -rf -- "$dir"
		_error 'cannot create clipboard FIFOs'
		exit 1
	}
	trap 'rm -rf -- "$dir"' 0 HUP INT TERM

	_store get "$name" >"$plain" &
	decrypt_pid=$!

	awk 'NR == 1 { printf "%s", $0 }' <"$plain" >"$first" &
	extract_pid=$!

	_clip <"$first"
	clip_rc=$?

	wait "$extract_pid"
	extract_rc=$?
	wait "$decrypt_pid"
	decrypt_rc=$?

	[ "$decrypt_rc" -eq 0 ] &&
	[ "$extract_rc" -eq 0 ] &&
	[ "$clip_rc" -eq 0 ] || {
		_error "cannot copy first line of [$name]"
		exit 1
	}

	_info "first line copied: [$name]"
)

_copy_full() (
	name=$1
	dir=$(_tmpdir) || {
		_error 'cannot create temporary clipboard directory'
		exit 1
	}
	plain=$dir/plain
	mkfifo "$plain" || {
		rm -rf -- "$dir"
		_error 'cannot create clipboard FIFO'
		exit 1
	}
	trap 'rm -rf -- "$dir"' 0 HUP INT TERM

	_store get "$name" >"$plain" &
	decrypt_pid=$!

	_clip <"$plain"
	clip_rc=$?

	wait "$decrypt_pid"
	decrypt_rc=$?

	[ "$decrypt_rc" -eq 0 ] && [ "$clip_rc" -eq 0 ] || {
		_error "cannot copy [$name]"
		exit 1
	}

	_info "entry copied: [$name]"
)

_copy_otp() (
	name=$1
	dir=$(_tmpdir) || {
		_error 'cannot create temporary OTP directory'
		exit 1
	}
	otp=$dir/otp
	first=$dir/first
	mkfifo "$otp" "$first" || {
		rm -rf -- "$dir"
		_error 'cannot create OTP FIFOs'
		exit 1
	}
	trap 'rm -rf -- "$dir"' 0 HUP INT TERM

	_store otp "$name" >"$otp" &
	otp_pid=$!

	awk 'NR == 1 { printf "%s", $0 }' <"$otp" >"$first" &
	extract_pid=$!

	_clip <"$first"
	clip_rc=$?

	wait "$extract_pid"
	extract_rc=$?
	wait "$otp_pid"
	otp_rc=$?

	[ "$otp_rc" -eq 0 ] &&
	[ "$extract_rc" -eq 0 ] &&
	[ "$clip_rc" -eq 0 ] || {
		_error "cannot generate/copy TOTP for [$name]"
		exit 1
	}

	_info "TOTP copied: [$name]"
)

_view_entry() (
	name=$1
	dir=$(_tmpdir) || {
		_error 'cannot create temporary view directory'
		exit 1
	}
	plain=$dir/plain
	mkfifo "$plain" || {
		rm -rf -- "$dir"
		_error 'cannot create view FIFO'
		exit 1
	}
	trap 'rm -rf -- "$dir"' 0 HUP INT TERM

	printf '\n--- %s ---\n' "$name" >&2

	_store get "$name" >"$plain" &
	decrypt_pid=$!

	_pager <"$plain"
	pager_rc=$?

	wait "$decrypt_pid"
	decrypt_rc=$?

	[ "$pager_rc" -eq 0 ] || exit "$pager_rc"
	[ "$decrypt_rc" -eq 0 ] || {
		_error "cannot decrypt [$name]"
		exit "$decrypt_rc"
	}
	_pause
)

_pause() {
	printf '\npress Enter to continue...' >/dev/tty
	IFS= read -r dummy </dev/tty || :
}

_show_policy() {
	name=$1
	printf '\n%s -> ' "$name" >/dev/tty
	_store policy "$name" >/dev/tty 2>&1
	rc=$?
	_pause
	return "$rc"
}

_confirm_remove() {
	name=$1
	printf 'remove [%s]? [y/N] ' "$name" >/dev/tty
	IFS= read -r answer </dev/tty || return 1
	case $answer in
		y|Y|yes|YES|Yes) return 0 ;;
		*) return 1 ;;
	esac
}

_remove_entry() {
	name=$1
	_confirm_remove "$name" || return 0
	_store rm "$name"
}

_new_entry() {
	printf 'new entry name: ' >/dev/tty
	IFS= read -r name </dev/tty || return 1
	[ -n "$name" ] || return 0
	_store edit "$name"
}

_self_path() {
	case $0 in
		/*)
			printf '%s\n' "$0"
			;;
		*/*)
			printf '%s/%s\n' "$PWD" "${0#./}"
			;;
		*)
			command -v "$0"
			;;
	esac
}

_list_entries() {
	prefix=${1:-}
	if [ -n "$prefix" ]; then
		_store ls "$prefix"
	else
		_store ls
	fi
}

_internal() {
	cmd=$1
	shift

	_require_sec || exit 1

	case $cmd in
		--list)       _list_entries "${1:-}" ;;
		--copy-first) [ "$#" -eq 1 ] && _copy_first_line "$1" ;;
		--copy-name)  [ "$#" -eq 1 ] && _copy_name "$1" ;;
		--copy-full)  [ "$#" -eq 1 ] && _copy_full "$1" ;;
		--otp)        [ "$#" -eq 1 ] && _copy_otp "$1" ;;
		--view)       [ "$#" -eq 1 ] && _view_entry "$1" ;;
		--policy)     [ "$#" -eq 1 ] && _show_policy "$1" ;;
		--edit)       [ "$#" -eq 1 ] && _store edit "$1" ;;
		--rekey)      [ "$#" -eq 1 ] && _store rekey "$1" ;;
		--remove)     [ "$#" -eq 1 ] && _remove_entry "$1" ;;
		--new)        [ "$#" -eq 0 ] && _new_entry ;;
		*) exit 1 ;;
	esac
}

_run_fzf() (
	prefix=$1
	list=$(_tmpfile) || {
		_error 'cannot create temporary entry list'
		exit 1
	}
	trap 'rm -f -- "$list"' 0 HUP INT TERM

	_list_entries "$prefix" >"$list" || exit 1

	SEC_STORE_FZF_SELF=$(_self_path) || exit 1
	SEC_STORE_FZF_PREFIX=$prefix
	export SEC_STORE_FZF_SELF SEC_STORE_FZF_PREFIX

	_debug "starting fzf for prefix [${prefix:-/}]"

	# Keep one fzf process alive. Copy/view/edit/rekey actions return to the same
	# query and cursor position. Only actions that change the set of entries
	# reload the candidate list; fzf keeps the current query across reloads.
	"$( _fzf )" \
		--cycle \
		--no-multi \
		--prompt='sec> ' \
		--header='Ctrl-i:1stline Ctrl-u:name Ctrl-o:TOTP Ctrl-y:full Ctrl-v:view Ctrl-e:edit Ctrl-a:new Ctrl-h:policy Ctrl-r:rekey Ctrl-d:rm' \
		--bind='Ctrl-i:execute("$SEC_STORE_FZF_SELF" --copy-first {})' \
		--bind='ctrl-u:execute("$SEC_STORE_FZF_SELF" --copy-name {})' \
		--bind='ctrl-y:execute("$SEC_STORE_FZF_SELF" --copy-full {})' \
		--bind='ctrl-o:execute("$SEC_STORE_FZF_SELF" --otp {})' \
		--bind='ctrl-v:execute("$SEC_STORE_FZF_SELF" --view {})' \
		--bind='ctrl-h:execute("$SEC_STORE_FZF_SELF" --policy {})' \
		--bind='ctrl-e:execute("$SEC_STORE_FZF_SELF" --edit {})' \
		--bind='ctrl-r:execute("$SEC_STORE_FZF_SELF" --rekey {})' \
		--bind='ctrl-d:execute("$SEC_STORE_FZF_SELF" --remove {})+reload("$SEC_STORE_FZF_SELF" --list "$SEC_STORE_FZF_PREFIX")' \
		--bind='ctrl-a:execute("$SEC_STORE_FZF_SELF" --new)+reload("$SEC_STORE_FZF_SELF" --list "$SEC_STORE_FZF_PREFIX")' \
		<"$list" >/dev/null
)

main() {
	case ${1:-} in
		--list|--copy-first|--copy-name|--copy-full|--otp|--view|--policy|--edit|--rekey|--remove|--new)
			cmd=$1
			shift
			_internal "$cmd" "$@"
			exit $?
			;;
		-h|--help|help)
			usage
			exit 0
			;;
	esac

	[ "$#" -le 1 ] || {
		_error 'usage: sec-store-fzf [prefix]'
		exit 1
	}

	_require_commands || exit 1
	_run_fzf "${1:-}"
}

main "$@"

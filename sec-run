#!/bin/sh
# Run a command with secrets from sec-store. POSIX sh; no eval/source of secrets.

VERSION=0.9.0

umask 077
set -f
_CR=$(printf '\r')

usage() {
	printf 'sec-run %s\n' "$VERSION"
	cat <<'USAGE'
    inject sec-store secrets into a command's environment and temporary files

usage:
    sec run [options] [-- command [args ...]]
    sec run manifest ls
    sec run manifest edit NAME
    sec run manifest rm NAME [...]
    sec run m ls
    sec-run [options] [-- command [args ...]]
    sec-run manifest|m ls|edit|rm ...

manifest commands (manifest|m):
    manifest|m ls|l                list named manifests in selected sec/run/
    manifest|m edit|e NAME         edit/create a local named manifest
    manifest|m rm|r NAME [...]     remove local named manifests

options:
    -e, --env ENTRY              load literal NAME=VALUE lines from an entry (repeatable)
    -v, --var ENV_VAR:ENTRY      export ENV_VAR with the literal contents of one entry
                                (repeatable)
    --val ENV_VAR=VALUE          export a literal non-secret value (repeatable)
    -f, --file ENTRY[:ENV_VAR]   materialize an entry and export its file path
                                (repeatable; default ENV_VAR from basename)
    -m, --manifest REF          load env/var/val/file entries from a declarative manifest
                                REF is NAME, ALIAS::NAME, or an explicit PATH
    --print                     display resolved variables, including secret values;
                                file paths are placeholders, not usable runtime paths
    --env-only                  output resolved NAME=VALUE lines (no -f allowed)
    -V, --version               show version
    -h, --help                  show help

No command: inspect the injection without printing secret values. Inspect output
shows the selected store, loaded manifests, source entries and directive origin.
For var entries it also warns about a trailing LF or CRLF without modifying the
secret value. Use -- to separate runner options from the command. --print and --env-only
cannot be combined with a command. -e entries are merged in order (last wins).
Duplicate --val/-v/-f variable names or file paths, and collisions between
-e, --val, -v and -f variables, are errors. A -v value is the exact entry
contents; NUL bytes are rejected because Unix environment variables cannot
contain them. --val splits on the first '=' and treats the remainder literally:
no interpolation, quoting rules, command substitution or shell syntax.

A manifest contains one directive per line:
    env ENTRY
    var ENV_VAR:ENTRY
    val ENV_VAR=VALUE
    file ENTRY[:ENV_VAR]
The aliases -e, -v and -f are accepted for env/var/file. Blank lines and #
comments are ignored. A val VALUE may contain spaces and additional '='
characters; it is literal data and is not expanded. Manifest content is data,
never shell code. A bare NAME resolves in the selected container's run/
directory (project .sec/run or personal ~/.local/share/sec/run).
ALIAS::NAME resolves NAME in that aliased container's run/ directory;
unqualified env/var/file entries inside it inherit ALIAS automatically.
Already-qualified entries are left unchanged. Explicit manifest paths work
with any store and do not inherit an alias. Aliased manifests are read-only;
manifest edit/rm operate on the selected local container. Aliases are declared
in the selected container's stores file.

The .env format is literal, one NAME=VALUE per line; empty lines and lines
beginning with # are ignored. No quotes, interpolation or shell syntax.
A file entry's relative path is preserved under SEC_RUN_DIR (mode 0700).
A materialized file has mode 0600. SEC_RUN_DIR contains temporary paths,
not the secret contents. These paths remain available only while the command
is running. The runner returns the command's exit status.

env vars:
    SEC_STORE_DIR        optional explicit store location (handled by sec-store)
    SEC_STORE_REQUIRE_PROJECT    if 1, disallow personal-store fallback
    SEC_RUN_SEC          sec executable (default: sec)
    SEC_RUN_TMPDIR       explicit private temporary parent (default: XDG_RUNTIME_DIR)
    SEC_RUN_EDITOR       editor executable for `manifest edit`
                         default: $VISUAL, $EDITOR, vi
    SEC_RUN_DEBUG        enable diagnostics; never prints secret contents

SEC_RUN_TMPDIR must be a real directory owned by the current user and
inaccessible to group/other users (typically mode 0700). No implicit /tmp
fallback. Prefer a private tmpfs: XDG_RUNTIME_DIR may not always be tmpfs.
USAGE
}

_error() { printf 'sec-run: error: %s\n' "$1" >&2; return 1; }
_debug() { [ -z "${SEC_RUN_DEBUG:-}" ] || printf 'sec-run: debug: %s\n' "$1" >&2; return 0; }

_tmp=
_child=
_cleanup() {
	[ -z "$_tmp" ] || rm -rf -- "$_tmp"
}
_signal() {
	_sig=$1
	trap - HUP INT TERM
	if [ -n "$_child" ]; then
		kill -s "$_sig" "$_child" 2>/dev/null || :
		wait "$_child" 2>/dev/null || :
	fi
	case $_sig in HUP) exit 129 ;; INT) exit 130 ;; TERM) exit 143 ;; esac
}
trap '_cleanup' 0
trap '_signal HUP' HUP
trap '_signal INT' INT
trap '_signal TERM' TERM

_require_runtime() {
	_rt=${SEC_RUN_TMPDIR:-${XDG_RUNTIME_DIR:-}}
	[ -n "$_rt" ] || { _error 'XDG_RUNTIME_DIR is not set; set SEC_RUN_TMPDIR to a private directory'; return 1; }
	[ -d "$_rt" ] && [ ! -L "$_rt" ] && [ -w "$_rt" ] && [ -x "$_rt" ] || {
		_error "temporary parent [$_rt] must be a writable, non-symlink directory"
		return 1
	}
	_rt_owner=$(stat -c %u -- "$_rt") || return 1
	_rt_mode=$(stat -c %a -- "$_rt") || return 1
	_rt_uid=$(id -u) || return 1
	[ "$_rt_owner" = "$_rt_uid" ] || { _error "temporary parent [$_rt] is not owned by you"; return 1; }
	case $_rt_mode in ''|*[!0-7]*) _error 'cannot validate temporary-parent permissions'; return 1 ;; esac
	[ "$((0$_rt_mode & 077))" -eq 0 ] || {
		_error "temporary parent [$_rt] is accessible to group/other users"
		return 1
	}
	case $_rt in *'
'*) _error 'newline in temporary-parent path is not supported'; return 1 ;; esac
	_tmp=$(mktemp -d "$_rt/sec-run.XXXXXXXX") || { _error 'cannot create temporary workspace'; return 1; }
	mkdir -m 700 -- "$_tmp/envs" "$_tmp/values" "$_tmp/literals" "$_tmp/files" || return 1
	: >"$_tmp/env-entries" && : >"$_tmp/env-origins" &&
	: >"$_tmp/env-meta" && : >"$_tmp/value-specs" &&
	: >"$_tmp/value-vars" && : >"$_tmp/value-files" &&
	: >"$_tmp/value-meta" && : >"$_tmp/literal-vars" &&
	: >"$_tmp/literal-files" && : >"$_tmp/literal-meta" &&
	: >"$_tmp/file-specs" && : >"$_tmp/file-vars" &&
	: >"$_tmp/file-paths" && : >"$_tmp/file-meta" &&
	: >"$_tmp/env-keys" && : >"$_tmp/env-files" &&
	: >"$_tmp/manifests-used"
}

_valid_var() {
	case $1 in ''|[!A-Za-z_]*|*[!A-Za-z0-9_]*) return 1 ;; esac
	[ "$1" != SEC_RUN_DIR ]
}

_valid_entry() {
	case $1 in
		''|/*|.|..|./*|../*|*/.|*/..|*/./*|*/../*|*//*|*:*|*'
'*|*"$_CR"*) return 1 ;;
	esac
	return 0
}

_canonical_entry() {
    _entry=$1
    case $_entry in *.age) _entry=${_entry%.age} ;; esac
    case $_entry in
        *::*)
            _ce_alias=${_entry%%::*}
            _ce_path=${_entry#*::}
            case $_ce_alias in ''|[!a-z]*|*[!a-z0-9_-]*) _error "invalid store alias [$_ce_alias]"; return 1 ;; esac
            _valid_entry "$_ce_path" || { _error "invalid entry name [$_entry]"; return 1; }
            printf '%s::%s\n' "$_ce_alias" "$_ce_path"
            ;;
        *) _valid_entry "$_entry" || { _error "invalid entry name [$_entry]"; return 1; }
           printf '%s\n' "$_entry" ;;
    esac
}

_derive_var() {
    _dv_entry=$1
    case $_dv_entry in *::*) _dv_entry=${_dv_entry#*::} ;; esac
	_base=${_dv_entry##*/}
	_derived=$(printf '%s' "$_base" | LC_ALL=C tr '[:lower:]' '[:upper:]' |
		LC_ALL=C tr -c 'A-Z0-9_' '_') || return 1
	case $_derived in [0-9]*) _derived=_$_derived ;; esac
	_valid_var "$_derived" || { _error "cannot derive variable name from [$1]"; return 1; }
	printf '%s\n' "$_derived"
}

_has_line() { grep -Fqx -e "$1" "$2"; }

_add_env() {
	_ae=$(_canonical_entry "$1") || return 1
	_ae_origin=${2:-cli}
	printf '%s\n' "$_ae" >>"$_tmp/env-entries" || return 1
	printf '%s\n' "$_ae_origin" >>"$_tmp/env-origins" || return 1
}

_add_value() {
	_av_spec=$1
	case $_av_spec in
		*:* ) _av_var=${_av_spec%%:*}; _av_entry=${_av_spec#*:} ;;
		* ) _error "invalid variable specification [$_av_spec]; expected ENV_VAR:ENTRY"; return 1 ;;
	esac
	_valid_var "$_av_var" || { _error "invalid variable name [$_av_var]"; return 1; }
	[ -n "$_av_entry" ] || { _error "missing store entry in variable specification [$_av_spec]"; return 1; }
	_av_entry=$(_canonical_entry "$_av_entry") || return 1
	_has_line "$_av_var" "$_tmp/value-vars" && { _error "duplicate value variable [$_av_var]"; return 1; }
	_has_line "$_av_var" "$_tmp/literal-vars" && { _error "variable [$_av_var] conflicts with a literal variable"; return 1; }
	_has_line "$_av_var" "$_tmp/file-vars" && { _error "variable [$_av_var] conflicts with a file variable"; return 1; }
	printf '%s\n' "$_av_var" >>"$_tmp/value-vars" || return 1
	printf '%s\n%s\n' "$_av_entry" "$_av_var" >>"$_tmp/value-specs" || return 1
	printf '%s\n%s\n%s\n' "$_av_var" "$_av_entry" "${2:-cli}" >>"$_tmp/value-meta" || return 1
}

_add_literal() {
	_al_spec=$1
	case $_al_spec in
		*=*) _al_var=${_al_spec%%=*}; _al_value=${_al_spec#*=} ;;
		*) _error "invalid literal specification [$_al_spec]; expected ENV_VAR=VALUE"; return 1 ;;
	esac
	_valid_var "$_al_var" || { _error "invalid variable name [$_al_var]"; return 1; }
	_has_line "$_al_var" "$_tmp/literal-vars" && { _error "duplicate literal variable [$_al_var]"; return 1; }
	_has_line "$_al_var" "$_tmp/value-vars" && { _error "literal variable [$_al_var] conflicts with a value variable"; return 1; }
	_has_line "$_al_var" "$_tmp/file-vars" && { _error "literal variable [$_al_var] conflicts with a file variable"; return 1; }
	_al_count=0
	while IFS= read -r _al_existing || [ -n "$_al_existing" ]; do
		_al_count=$((_al_count + 1))
	done <"$_tmp/literal-vars"
	_al_count=$((_al_count + 1))
	_al_file=$_tmp/literals/$_al_count
	printf '%s' "$_al_value" >"$_al_file" || return 1
	_check_env_bytes "$_al_file" || return 1
	printf '%s\n' "$_al_var" >>"$_tmp/literal-vars" || return 1
	printf '%s\n%s\n' "$_al_var" "$_al_file" >>"$_tmp/literal-files" || return 1
	printf '%s\n%s\n' "$_al_var" "${2:-cli}" >>"$_tmp/literal-meta" || return 1
}

_add_file() {
    _spec=$1
    _af_explicit=0
    # Parse an optional ENV_VAR after the qualified alias delimiter, not the
    # colon inside alias::entry itself.
    case $_spec in
        *::*)
            _af_alias=${_spec%%::*}
            _af_tail=${_spec#*::}
            case $_af_tail in
                *:*) _entry=$_af_alias::${_af_tail%:*}; _var=${_af_tail##*:}; _af_explicit=1 ;;
                *) _entry=$_spec; _var= ;;
            esac
            ;;
        *:*) _entry=${_spec%:*}; _var=${_spec##*:}; _af_explicit=1 ;;
        *) _entry=$_spec; _var= ;;
    esac
    if [ "$_af_explicit" -eq 1 ]; then
        _valid_var "$_var" || { _error "invalid file variable name [$_var]"; return 1; }
    fi
    _entry=$(_canonical_entry "$_entry") || return 1
    [ -n "$_var" ] || _var=$(_derive_var "$_entry") || return 1
    _af_rel=$_entry
    case $_entry in *::*) _af_rel=${_entry%%::*}/${_entry#*::} ;; esac
    _has_line "$_var" "$_tmp/file-vars" && { _error "duplicate file variable [$_var]"; return 1; }
    _has_line "$_var" "$_tmp/value-vars" && { _error "file variable [$_var] conflicts with a value variable"; return 1; }
    _has_line "$_var" "$_tmp/literal-vars" && { _error "file variable [$_var] conflicts with a literal variable"; return 1; }
    _has_line "$_af_rel" "$_tmp/file-paths" && { _error "duplicate file destination [$_af_rel]"; return 1; }
    printf '%s\n' "$_var" >>"$_tmp/file-vars" || return 1
    printf '%s\n' "$_af_rel" >>"$_tmp/file-paths" || return 1
    printf '%s\n%s\n%s\n' "$_entry" "$_var" "$_af_rel" >>"$_tmp/file-specs" || return 1
    printf '%s\n%s\n%s\n%s\n' "$_var" "$_entry" "$_af_rel" "${2:-cli}" >>"$_tmp/file-meta" || return 1
}

# Pin the store once so every entry in this run uses the same store, even if
# the command was invoked from a nested directory or used a named manifest.
_pin_store() {
    [ -n "${_store_dir:-}" ] && return 0
    # Capture the logical container before SEC_STORE_DIR becomes an explicit
    # physical path. This preserves project stores whose store/ is a symlink,
    # and also supports named manifests in the personal sec/run directory.
    _container_root=$("$_sec_bin" store root) || {
        _error 'cannot resolve sec container'; return 1;
    }
    _store_dir=$("$_sec_bin" store dir) || {
        _error 'cannot resolve store directory'; return 1;
    }
    SEC_STORE_CONTEXT_ROOT=$_container_root
    SEC_STORE_DIR=$_store_dir
    export SEC_STORE_CONTEXT_ROOT SEC_STORE_DIR
}

_manifest_path() {
    _mp_ref=$1
    case $_mp_ref in
        /*|./*|../*) printf '%s\n' "$_mp_ref"; return 0 ;;
    esac

    _pin_store || return 1

    # A versioned project manifest must not depend on developer-local aliases.
    _mp_project=$("$_sec_bin" store dir --project-sec 2>/dev/null) || _mp_project=
    [ -z "$_mp_project" ] || { SEC_STORE_PROJECT_ONLY=1; export SEC_STORE_PROJECT_ONLY; }

    _mp_container=$_container_root
    _mp_name=$_mp_ref
    case $_mp_ref in
        *::*)
            _mp_alias=${_mp_ref%%::*}
            _mp_name=${_mp_ref#*::}
            case $_mp_alias in
                ''|[!a-z]*|*[!a-z0-9_-]*)
                    _error "invalid store alias [$_mp_alias]"
                    return 1
                    ;;
            esac
            [ -n "$_mp_name" ] || { _error "missing manifest name in [$_mp_ref]"; return 1; }
            _mp_container=$("$_sec_bin" store root "$_mp_alias") || {
                _error "cannot resolve manifest store alias [$_mp_alias]"
                return 1
            }
            ;;
        *:*)
            _error "invalid manifest reference [$_mp_ref]; use ALIAS::NAME"
            return 1
            ;;
    esac

    _valid_entry "$_mp_name" || { _error "invalid manifest name [$_mp_name]"; return 1; }
    _mp_rest=$_mp_name
    _mp_cur=$_mp_container/run
    [ ! -L "$_mp_cur" ] || { _error "symlinked manifest directory [$_mp_cur]"; return 1; }
    while :; do
        case $_mp_rest in
            */*) _mp_part=${_mp_rest%%/*}; _mp_rest=${_mp_rest#*/} ;;
            *) _mp_part=$_mp_rest; _mp_rest= ;;
        esac
        _mp_cur=$_mp_cur/$_mp_part
        [ ! -L "$_mp_cur" ] || { _error "symlinked manifest path [$_mp_cur]"; return 1; }
        [ -n "$_mp_rest" ] || break
    done
    printf '%s\n' "$_mp_cur"
}

_manifest_entry_arg() {
    _mea_alias=$1
    _mea_arg=$2
    if [ -z "$_mea_alias" ]; then
        printf '%s\n' "$_mea_arg"
        return 0
    fi
    case $_mea_arg in
        *::*) printf '%s\n' "$_mea_arg" ;;
        *) printf '%s::%s\n' "$_mea_alias" "$_mea_arg" ;;
    esac
}

_manifest_value_arg() {
    _mva_alias=$1
    _mva_arg=$2
    [ -n "$_mva_alias" ] || { printf '%s\n' "$_mva_arg"; return 0; }
    case $_mva_arg in
        *:*)
            _mva_var=${_mva_arg%%:*}
            _mva_entry=${_mva_arg#*:}
            case $_mva_entry in
                *::*) printf '%s\n' "$_mva_arg" ;;
                *) printf '%s:%s::%s\n' "$_mva_var" "$_mva_alias" "$_mva_entry" ;;
            esac
            ;;
        *) printf '%s\n' "$_mva_arg" ;;
    esac
}

_manifest_file_arg() {
    _mfa_alias=$1
    _mfa_arg=$2
    [ -n "$_mfa_alias" ] || { printf '%s\n' "$_mfa_arg"; return 0; }
    case $_mfa_arg in
        *::*) printf '%s\n' "$_mfa_arg" ;;
        *) printf '%s::%s\n' "$_mfa_alias" "$_mfa_arg" ;;
    esac
}

_load_manifest() {
    _lm_ref=$1
    _lm_default_alias=
    case $_lm_ref in
        /*|./*|../*) ;;
        *::*) _lm_default_alias=${_lm_ref%%::*} ;;
    esac
    _lm_path=$(_manifest_path "$_lm_ref") || return 1
    case $_lm_ref in
        /*|./*|../*) ;;
        *)
            if "$_sec_bin" store dir --project-sec >/dev/null 2>&1; then
                SEC_STORE_PROJECT_ONLY=1
                export SEC_STORE_PROJECT_ONLY
            fi
            ;;
    esac
    [ -f "$_lm_path" ] && [ -r "$_lm_path" ] && [ ! -L "$_lm_path" ] || {
        _error "manifest [$_lm_path] is not a readable regular file"
        return 1
    }
    printf '%s\n%s\n' "$_lm_ref" "$_lm_path" >>"$_tmp/manifests-used" || return 1
    _lm_num=0
    while IFS= read -r _lm_line || [ -n "$_lm_line" ]; do
        _lm_num=$((_lm_num + 1))
        # Strip indentation only. For `val`, trailing spaces are part of VALUE.
        _lm_line=$(printf '%s' "$_lm_line" | sed 's/^[[:space:]]*//') || return 1
        case $_lm_line in ''|\#*) continue ;; esac
        case $_lm_line in
            *[[:space:]]*)
                _lm_kind=${_lm_line%%[[:space:]]*}
                _lm_arg=${_lm_line#"$_lm_kind"}
                _lm_arg=$(printf '%s' "$_lm_arg" | sed 's/^[[:space:]]*//') || return 1
                ;;
            *) _error "invalid manifest directive at [$_lm_path:$_lm_num]"; return 1 ;;
        esac
        [ -n "$_lm_arg" ] || { _error "invalid manifest argument at [$_lm_path:$_lm_num]"; return 1; }
        case $_lm_kind in
            val)
                _add_literal "$_lm_arg" "manifest $_lm_ref:$_lm_num" || return 1
                ;;
            env|-e|var|-v|file|-f)
                _lm_arg=$(printf '%s' "$_lm_arg" | sed 's/[[:space:]]*$//') || return 1
                case $_lm_arg in ''|*[[:space:]]*)
                    _error "invalid manifest argument at [$_lm_path:$_lm_num]"
                    return 1 ;;
                esac
                case $_lm_kind in
                    env|-e)
                        _lm_effective=$(_manifest_entry_arg "$_lm_default_alias" "$_lm_arg") || return 1
                        _add_env "$_lm_effective" "manifest $_lm_ref:$_lm_num" || return 1
                        ;;
                    var|-v)
                        _lm_effective=$(_manifest_value_arg "$_lm_default_alias" "$_lm_arg") || return 1
                        _add_value "$_lm_effective" "manifest $_lm_ref:$_lm_num" || return 1
                        ;;
                    file|-f)
                        _lm_effective=$(_manifest_file_arg "$_lm_default_alias" "$_lm_arg") || return 1
                        _add_file "$_lm_effective" "manifest $_lm_ref:$_lm_num" || return 1
                        ;;
                esac
                ;;
            *) _error "unknown manifest directive [$_lm_kind] at [$_lm_path:$_lm_num]"; return 1 ;;
        esac
        _seen=1
    done <"$_lm_path"
}

_manifest_editor() {
    printf '%s\n' "${SEC_RUN_EDITOR:-${VISUAL:-${EDITOR:-vi}}}"
}

_manifest_run_dir() {
    _pin_store || return 1
    _mr_dir=$_container_root/run
    [ ! -L "$_mr_dir" ] || { _error "symlinked manifest directory [$_mr_dir]"; return 1; }
    if [ -e "$_mr_dir" ] && [ ! -d "$_mr_dir" ]; then
        _error "manifest path [$_mr_dir] is not a directory"
        return 1
    fi
}

_manifest_edit_path() {
    _me_name=$1
    _valid_entry "$_me_name" || { _error "invalid manifest name [$_me_name]"; return 1; }
    _manifest_run_dir || return 1
    if [ ! -d "$_mr_dir" ]; then
        mkdir -p -- "$_mr_dir" || { _error "cannot create manifest directory [$_mr_dir]"; return 1; }
    fi
    _me_rest=$_me_name
    _me_cur=$_mr_dir
    while :; do
        case $_me_rest in
            */*) _me_part=${_me_rest%%/*}; _me_rest=${_me_rest#*/} ;;
            *) _me_part=$_me_rest; _me_rest= ;;
        esac
        _me_cur=$_me_cur/$_me_part
        [ ! -L "$_me_cur" ] || { _error "symlinked manifest path [$_me_cur]"; return 1; }
        if [ -n "$_me_rest" ]; then
            if [ -e "$_me_cur" ]; then
                [ -d "$_me_cur" ] || { _error "manifest path component [$_me_cur] is not a directory"; return 1; }
            else
                mkdir -- "$_me_cur" || { _error "cannot create manifest directory [$_me_cur]"; return 1; }
            fi
        else
            if [ -e "$_me_cur" ] && [ ! -f "$_me_cur" ]; then
                _error "manifest [$_me_cur] is not a regular file"
                return 1
            fi
            printf '%s\n' "$_me_cur"
            return 0
        fi
    done
}

_manifest_list() {
    [ "$#" -eq 0 ] || { _error 'usage: sec run manifest ls'; return 2; }
    _manifest_run_dir || return 1
    [ -d "$_mr_dir" ] || return 0
    find "$_mr_dir" -type f -print | while IFS= read -r _ml_path; do
        _ml_name=${_ml_path#"$_mr_dir"/}
        _valid_entry "$_ml_name" || continue
        printf '%s\n' "$_ml_name"
    done | LC_ALL=C sort
}

_manifest_edit() {
    [ "$#" -eq 1 ] || { _error 'usage: sec run manifest edit NAME'; return 2; }
    case $1 in
        *::*) _error "aliased manifest [$1] is read-only"; return 1 ;;
    esac
    _me_path=$(_manifest_edit_path "$1") || return 1
    _me_editor=$(_manifest_editor) || return 1
    "$_me_editor" "$_me_path"
}

_manifest_rm() {
    [ "$#" -gt 0 ] || { _error 'usage: sec run manifest rm NAME [...]'; return 2; }
    _mrm_rc=0
    for _mrm_name do
        case $_mrm_name in
            *::*)
                _error "aliased manifest [$_mrm_name] is read-only"
                _mrm_rc=1
                continue
                ;;
        esac
        _mrm_path=$(_manifest_path "$_mrm_name") || { _mrm_rc=1; continue; }
        if [ ! -f "$_mrm_path" ] || [ -L "$_mrm_path" ]; then
            _error "manifest [$_mrm_name] does not exist"
            _mrm_rc=1
            continue
        fi
        rm -- "$_mrm_path" || _mrm_rc=1
    done
    return "$_mrm_rc"
}

_manifest_cmd() {
    _mc=${1:-}
    [ "$#" -gt 0 ] && shift
    case $_mc in
        ls|l) _manifest_list "$@" ;;
        edit|e) _manifest_edit "$@" ;;
        rm|r) _manifest_rm "$@" ;;
        -h|--help|help|'')
            cat <<'USAGE'
usage:
    sec run manifest ls
    sec run manifest edit NAME
    sec run manifest rm NAME [...]
    sec run m ls|edit|rm ...

`m` is a short alias for `manifest`.

commands:
    ls|l            list named manifests in the selected sec/run/ directory
    edit|e NAME     edit or create local NAME; creates run/ and parent dirs as needed
    rm|r NAME ...   remove local named manifests

Aliased manifests (ALIAS::NAME) are loaded with -m/--manifest and are read-only.
USAGE
            ;;
        *) _error "unknown manifest command [$_mc]"; return 2 ;;
    esac
}

_check_env_bytes() {
	_ceb_file=$1
	_ceb_orig=$(wc -c <"$_ceb_file") || return 1
	_ceb_without_nul=$(LC_ALL=C tr -d '\000' <"$_ceb_file" | wc -c) || return 1
	[ "$_ceb_orig" = "$_ceb_without_nul" ] || {
		_error 'an environment entry contains NUL bytes (unsupported)'
		return 1
	}
}

# Validate before exporting anything. Paths in env-files are private, generated
# by this runner; no decrypted input is executed as shell code.
_validate_env_file() {
	_ve_file=$1
	_ve_entry=$2
	_ve_origin=$3
	_check_env_bytes "$_ve_file" || return 1
	_ve_num=0
	while IFS= read -r _ve_line || [ -n "$_ve_line" ]; do
		_ve_num=$((_ve_num + 1))
		case $_ve_line in
			*[![:space:]]*) ;;
			*) continue ;;
		esac
		case $_ve_line in \#*) continue ;; esac
		case $_ve_line in
			*=*) _ve_name=${_ve_line%%=*} ;;
			*) _error "invalid NAME=VALUE assignment in environment entry, line $_ve_num"; return 1 ;;
		esac
		_valid_var "$_ve_name" || {
			_error "invalid/reserved environment variable [$_ve_name] on line $_ve_num"
			return 1
		}
		case $_ve_line in *"$_CR"*) _error "CR character in environment entry, line $_ve_num"; return 1 ;; esac
		_has_line "$_ve_name" "$_tmp/file-vars" && {
			_error "environment variable [$_ve_name] conflicts with a file variable"
			return 1
		}
		_has_line "$_ve_name" "$_tmp/value-vars" && {
			_error "environment variable [$_ve_name] conflicts with a value variable"
			return 1
		}
		_has_line "$_ve_name" "$_tmp/literal-vars" && {
			_error "environment variable [$_ve_name] conflicts with a literal variable"
			return 1
		}
		_has_line "$_ve_name" "$_tmp/env-keys" ||
			printf '%s\n' "$_ve_name" >>"$_tmp/env-keys" || return 1
		printf '%s\n%s\n%s\n' "$_ve_name" "$_ve_entry" "$_ve_origin" >>"$_tmp/env-meta" || return 1
	done <"$_ve_file"
}

_store_get() { "$_sec_bin" store get "$1"; }

_prepare_envs() {
	_pe_count=0
	while IFS= read -r _pe_entry || [ -n "$_pe_entry" ]; do
		[ -n "$_pe_entry" ] || continue
		_pe_count=$((_pe_count + 1))
		_pe_file=$_tmp/envs/$_pe_count
		_pe_origin=$(sed -n "${_pe_count}p" "$_tmp/env-origins") || return 1
		_debug "loading environment entry [$_pe_entry]"
		_store_get "$_pe_entry" >"$_pe_file" || { _error "cannot load environment entry [$_pe_entry]"; return 1; }
		_validate_env_file "$_pe_file" "$_pe_entry" "$_pe_origin" || return 1
		printf '%s\n' "$_pe_file" >>"$_tmp/env-files" || return 1
	done <"$_tmp/env-entries"
}

_prepare_values() {
	_pv_count=0
	while IFS= read -r _pv_entry && IFS= read -r _pv_var; do
		_pv_count=$((_pv_count + 1))
		_pv_file=$_tmp/values/$_pv_count
		_debug "loading value entry [$_pv_entry] for [$_pv_var]"
		_store_get "$_pv_entry" >"$_pv_file" || { _error "cannot load value entry [$_pv_entry]"; return 1; }
		_check_env_bytes "$_pv_file" || return 1
		printf '%s\n%s\n' "$_pv_var" "$_pv_file" >>"$_tmp/value-files" || return 1
	done <"$_tmp/value-specs"
}

_prepare_files() {
	while IFS= read -r _pf_entry &&
	      IFS= read -r _pf_var &&
	      IFS= read -r _pf_rel; do
		_pf_target=$_tmp/files/$_pf_rel
		_debug "loading file entry [$_pf_entry]"
		if [ "$_mode" = run ]; then
			_pf_parent=$(dirname -- "$_pf_target") || return 1
			mkdir -p -- "$_pf_parent" || { _error "cannot create directory for [$_pf_entry]"; return 1; }
			[ ! -e "$_pf_target" ] && [ ! -L "$_pf_target" ] || {
				_error "conflicting file destination [$_pf_rel]"
				return 1
			}
			_store_get "$_pf_entry" >"$_pf_target" || { _error "cannot load file entry [$_pf_entry]"; return 1; }
			chmod 600 -- "$_pf_target" || return 1
		else
			# Inspect/print verify decryptability without materializing file secrets.
			_store_get "$_pf_entry" >/dev/null || { _error "cannot load file entry [$_pf_entry]"; return 1; }
		fi
	done <"$_tmp/file-specs"
}

# Executed only in a subshell, after every secret has been validated. The
# parent/cleanup supervisor never exports the application environment.
_apply_env() {
	while IFS= read -r _ae_file || [ -n "$_ae_file" ]; do
		while IFS= read -r _ae_line || [ -n "$_ae_line" ]; do
			case $_ae_line in
				*[![:space:]]*) ;;
				*) continue ;;
			esac
			case $_ae_line in \#*) continue ;; esac
			export "$_ae_line" || return 1
		done <"$_ae_file"
	done <"$_tmp/env-files"
	while IFS= read -r _ae_var && IFS= read -r _ae_file; do
		# Appending a sentinel prevents command substitution from stripping the
		# value's trailing newlines; NUL bytes were rejected during preparation.
		_ae_value=$(cat -- "$_ae_file"; printf '.') || return 1
		_ae_value=${_ae_value%.}
		export "$_ae_var=$_ae_value" || return 1
	done <"$_tmp/value-files"
	while IFS= read -r _ae_var && IFS= read -r _ae_file; do
		_ae_value=$(cat -- "$_ae_file"; printf '.') || return 1
		_ae_value=${_ae_value%.}
		export "$_ae_var=$_ae_value" || return 1
	done <"$_tmp/literal-files"
	while IFS= read -r _ae_entry &&
	      IFS= read -r _ae_var &&
	      IFS= read -r _ae_rel; do
		export "$_ae_var=$_tmp/files/$_ae_rel" || return 1
	done <"$_tmp/file-specs"
	SEC_RUN_DIR=$_tmp/files
	export SEC_RUN_DIR
}

_value_trailing_eol() {
	_vte_var=$1
	_vte_file=
	while IFS= read -r _vte_name && IFS= read -r _vte_path; do
		if [ "$_vte_name" = "$_vte_var" ]; then
			_vte_file=$_vte_path
			break
		fi
	done <"$_tmp/value-files"
	[ -n "$_vte_file" ] && [ -s "$_vte_file" ] || return 1

	# Inspect at most the final two bytes. This is diagnostic only: var values
	# are still exported byte-for-byte (except NUL, which is rejected earlier).
	_vte_hex=$(tail -c 2 -- "$_vte_file" 2>/dev/null | od -An -t x1 | tr -d ' \n') || return 1
	case $_vte_hex in
		*0d0a) printf '%s\n' 'CRLF'; return 0 ;;
		*0a)   printf '%s\n' 'LF'; return 0 ;;
		*)     return 1 ;;
	esac
}

_inspect_env_key() {
	_iek_key=$1
	_iek_entry=
	_iek_origin=
	_iek_count=0
	while IFS= read -r _iek_var &&
	      IFS= read -r _iek_e &&
	      IFS= read -r _iek_o; do
		[ "$_iek_var" = "$_iek_key" ] || continue
		_iek_entry=$_iek_e
		_iek_origin=$_iek_o
		_iek_count=$((_iek_count + 1))
	done <"$_tmp/env-meta"
	[ "$_iek_count" -gt 0 ] || return 1
	printf '  %s=<secret>  env:%s  <- %s' "$_iek_key" "$_iek_entry" "$_iek_origin"
	if [ "$_iek_count" -gt 1 ]; then
		printf '  (overrides %s earlier env assignment' "$((_iek_count - 1))"
		[ "$_iek_count" -eq 2 ] || printf 's'
		printf ')'
	fi
	printf '\n'
}

_inspect() {
	printf 'Context:\n'
	printf '  container: %s\n' "$_container_root"
	printf '  store:     %s\n' "$_store_dir"

	if [ -s "$_tmp/manifests-used" ]; then
		printf '\nManifests:\n'
		while IFS= read -r _im_ref &&
		      IFS= read -r _im_path; do
			printf '  %s -> %s\n' "$_im_ref" "$_im_path"
		done <"$_tmp/manifests-used"
	fi

	printf '\nEnvironment:\n'
	while IFS= read -r _pr_key || [ -n "$_pr_key" ]; do
		_inspect_env_key "$_pr_key" || return 1
	done <"$_tmp/env-keys"

	while IFS= read -r _im_var &&
	      IFS= read -r _im_entry &&
	      IFS= read -r _im_origin; do
		printf '  %s=<secret>  var:%s  <- %s' "$_im_var" "$_im_entry" "$_im_origin"
		_im_eol=$(_value_trailing_eol "$_im_var") || _im_eol=
		[ -z "$_im_eol" ] || printf '  [trailing %s]' "$_im_eol"
		printf '\n'
	done <"$_tmp/value-meta"

	while IFS= read -r _im_var &&
	      IFS= read -r _im_origin; do
		printf '  %s=<literal>  val  <- %s\n' "$_im_var" "$_im_origin"
	done <"$_tmp/literal-meta"

	printf '\nFiles:\n'
	while IFS= read -r _im_var &&
	      IFS= read -r _im_entry &&
	      IFS= read -r _im_rel &&
	      IFS= read -r _im_origin; do
		printf '  %s=<file>  file:%s -> <SEC_RUN_DIR>/%s  <- %s\n' \
			"$_im_var" "$_im_entry" "$_im_rel" "$_im_origin"
	done <"$_tmp/file-meta"

	printf '\nRuntime:\n'
	printf '  SEC_RUN_DIR=<temporary directory>\n'
}

_print_resolved() (
	_apply_env || exit 1
	while IFS= read -r _pr_key || [ -n "$_pr_key" ]; do
		printf '%s=' "$_pr_key"
		"$_printenv_bin" "$_pr_key" || exit 1
	done <"$_tmp/env-keys"
	while IFS= read -r _pr_var || [ -n "$_pr_var" ]; do
		printf '%s=' "$_pr_var"
		"$_printenv_bin" "$_pr_var" || exit 1
	done <"$_tmp/value-vars"
	while IFS= read -r _pr_var || [ -n "$_pr_var" ]; do
		printf '%s=' "$_pr_var"
		"$_printenv_bin" "$_pr_var" || exit 1
	done <"$_tmp/literal-vars"
	if [ "$_mode" = print ]; then
		while IFS= read -r _pr_entry &&
		      IFS= read -r _pr_var &&
		      IFS= read -r _pr_rel; do
			printf '%s=<SEC_RUN_DIR>/%s\n' "$_pr_var" "$_pr_rel"
		done <"$_tmp/file-specs"
		printf 'SEC_RUN_DIR=<temporary directory>\n'
	fi
)

_run_command() {
	(
		# Resolve cleanup utility before imported PATH can change it.
		_run_rm=$(command -v rm) || exit 1
		_apply_env || exit 1
		# A decrypted environment source is needed only while preparing the child.
		"$_run_rm" -rf -- "$_tmp/envs" "$_tmp/values" "$_tmp/literals" || exit 1
		exec "$@"
	) &
	_child=$!
	wait "$_child"
	_rc=$?
	_child=
	return "$_rc"
}

main() {
	case ${1:-} in
		-V|--version|version) printf 'sec-run %s\n' "$VERSION"; return 0 ;;
		-h|--help|help) usage; return 0 ;;
		manifest|m)
			shift
			_sec_bin=$(command -v "${SEC_RUN_SEC:-sec}") || { _error 'sec executable not found'; return 1; }
			_manifest_cmd "$@"
			return $?
			;;
	esac
	_require_runtime || return 1
	_sec_bin=$(command -v "${SEC_RUN_SEC:-sec}") || { _error 'sec executable not found'; return 1; }
	_mode=inspect
	_mode_set=0
	_seen=0
	_command=0
	while [ "$#" -gt 0 ]; do
		case $1 in
			-e|--env)
				[ "$#" -ge 2 ] || { _error "missing ENTRY after [$1]"; return 2; }
				_add_env "$2" "cli -e" || return 2
				_seen=1
				shift 2
				;;
			-v|--var)
				[ "$#" -ge 2 ] || { _error "missing ENV_VAR:ENTRY after [$1]"; return 2; }
				_add_value "$2" "cli -v" || return 2
				_seen=1
				shift 2
				;;
			--val)
				[ "$#" -ge 2 ] || { _error "missing ENV_VAR=VALUE after [$1]"; return 2; }
				_add_literal "$2" "cli --val" || return 2
				_seen=1
				shift 2
				;;
			-f|--file)
				[ "$#" -ge 2 ] || { _error "missing ENTRY[:ENV_VAR] after [$1]"; return 2; }
				_add_file "$2" "cli -f" || return 2
				_seen=1
				shift 2
				;;
			-m|--manifest)
				[ "$#" -ge 2 ] || { _error "missing NAME|ALIAS::NAME|PATH after [$1]"; return 2; }
				_load_manifest "$2" || return 2
				shift 2
				;;
			--print)
				[ "$_mode_set" -eq 0 ] || { _error 'only one output mode can be selected'; return 2; }
				_mode=print; _mode_set=1; shift
				;;
			--env-only)
				[ "$_mode_set" -eq 0 ] || { _error 'only one output mode can be selected'; return 2; }
				_mode=env-only; _mode_set=1; shift
				;;
			--)
				shift
				[ "$#" -gt 0 ] || { _error 'a command is required after --'; return 2; }
				[ "$_mode_set" -eq 0 ] || { _error 'output modes cannot be combined with a command'; return 2; }
				_mode=run; _command=1
				break
				;;
			-V|--version) printf 'sec-run %s\n' "$VERSION"; return 0 ;;
			-h|--help) usage; return 0 ;;
			*) _error "unknown option [$1]; use -- before the command"; return 2 ;;
		esac
	done
	[ "$_seen" -eq 1 ] || { usage >&2; _error 'specify at least one -e, -v, --val or -f entry'; return 2; }
	if [ "$_mode" = env-only ] && [ -s "$_tmp/file-specs" ]; then
		_error '--env-only does not accept -f file entries'
		return 2
	fi
	if [ "$_mode" = print ] || [ "$_mode" = env-only ]; then
		_printenv_bin=$(command -v printenv) || { _error 'printenv is required for output modes'; return 1; }
	fi
	_pin_store || return 1
	_prepare_envs && _prepare_values && _prepare_files || return 1
	case $_mode in
		inspect) _inspect ;;
		print|env-only) _print_resolved ;;
		run) _run_command "$@" ;;
	esac
}

main "$@"

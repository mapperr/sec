#!/bin/sh

umask 077
set -f

usage() {
	s=$(basename "$0")
	cat <<EOF
$s
    encrypted personal/team secret store for sec

commands:
    init [--project]             initialize personal/current or project store
    dir [--source|--project-sec] print selected store, source or project root
    root                         print the selected sec container (stores/store/run)
    stores edit|path             edit or locate the current container's stores file
    sources                      list available store aliases and sources
    update <alias>|--all         refresh remote stores explicitly
    put <name> [file]            encrypt stdin or file (local store only)
    get <name>                   decrypt an entry; alias::name selects another store
    edit <name>                  edit a local secret
    ls [prefix|alias::[prefix]]  list local entries or an aliased store
    rm <name> [<name> ...]       remove local secrets
    policy <name>                show the effective recipient policy
    rekey [prefix]               re-encrypt local secrets using current policies
    check                        validate local store structure and ciphertexts
    git|g [args ...]             run git in selected local store (default: status)

env vars:
    SEC_STORE_DIR                store directory
                                 default: \${XDG_DATA_HOME:-~/.local/share}/sec/store
    SEC_STORE_SEC                sec executable
                                 default: sec
    SEC_STORE_EDITOR             editor executable
                                 default: \$VISUAL, \$EDITOR, vi
    SEC_STORE_CHECK_DECRYPT      if non-empty, try decrypting secrets during check
    SEC_STORE_CACHE_DIR          remote cache (default: ${XDG_CACHE_HOME:-~/.cache}/sec/stores)
    SEC_STORE_OFFLINE            if 1, do not fetch missing remote stores
    SEC_STORE_PROJECT_ONLY       if 1, do not use personal aliases as fallback
    SEC_STORE_DEBUG              enable debug messages

recipient policies:
    A .recipients file applies to secrets in its directory and descendants.
    The nearest .recipients file wins. If none exists, sec's self-recipient
    discovery is used.

    Explicit store policies are authoritative: sec-store never adds self to a
    .recipients policy.

notes:
    Secret names are store-relative paths and are stored as <name>.age.
    Plaintext is never written inside SEC_STORE_DIR.
    init --project creates .sec/store in the current directory.
    Valid symlinks for .sec, .sec/store and the personal store are supported.
    Symlinks within a store (secrets/policies) remain forbidden.
    Store containers contain store/, optional stores, and optional run/.
    Remote aliases are read-only; their repository is fetched on first use.
EOF
}

_name() { basename "$0"; }
_error() { printf '%s: error: %s\n' "$(_name)" "$1" >&2; return 1; }
_info() { printf '%s: %s\n' "$(_name)" "$1" >&2; }
_debug() {
	[ -n "${SEC_STORE_DEBUG:-}" ] &&
		printf '%s: debug: %s\n' "$(_name)" "$1" >&2
	return 0
}

_sec() {
	printf '%s\n' "${SEC_STORE_SEC:-sec}"
}

# Search upwards from the physical working directory. A project may link
# either .sec or .sec/store to an existing directory, including one outside
# the checkout. A dangling link or a non-directory is an error, not a reason
# to fall through to another project or the personal store.
_find_project_store() {
    _fps_dir=$(pwd -P) || return 2
    while :; do
        _fps_sec=$_fps_dir/.sec
        _fps_store=$_fps_sec/store
        if [ -L "$_fps_sec" ] || [ -e "$_fps_sec" ]; then
            [ -d "$_fps_sec" ] && [ -r "$_fps_sec" ] && [ -x "$_fps_sec" ] || {
                _error "project .sec [$_fps_sec] is not an accessible directory (possibly a dangling symlink)"
                return 2
            }
            if [ -L "$_fps_store" ] || [ -e "$_fps_store" ]; then
                [ -d "$_fps_store" ] && [ -r "$_fps_store" ] && [ -x "$_fps_store" ] || {
                    _error "project store [$_fps_store] is not an accessible directory (possibly a dangling symlink)"
                    return 2
                }
                printf '%s\n' "$_fps_store"
                return 0
            fi
        fi
        [ "$_fps_dir" = / ] && break
        _fps_dir=$(dirname -- "$_fps_dir") || return 2
    done
    return 1
}

# Do not silently override an explicitly set (even empty) SEC_STORE_DIR.
_root_raw() {
    if [ "${SEC_STORE_DIR+x}" = x ]; then
        [ -n "$SEC_STORE_DIR" ] || { _error 'SEC_STORE_DIR is empty'; return 1; }
        printf '%s\n' "$SEC_STORE_DIR"
        return 0
    fi
    if _rr_project=$(_find_project_store); then
        printf '%s\n' "$_rr_project"
        return 0
    else
        _rr_rc=$?
        [ "$_rr_rc" -eq 1 ] || return 1
    fi
    if [ "${SEC_STORE_REQUIRE_PROJECT:-0}" = 1 ]; then
        _error 'no .sec/store found; SEC_STORE_REQUIRE_PROJECT=1 forbids personal fallback'
        return 1
    fi
    printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/sec/store"
}

_root() {
    _sr=$(_root_raw) || return 1
    case $_sr in
        /) ;;
        */) _sr=${_sr%/} ;;
    esac
    # Resolve any existing store through symlinks, including the personal
    # default and an explicitly configured SEC_STORE_DIR. Never silently
    # reinterpret a dangling symlink as an uninitialized store.
    if [ -L "$_sr" ] && [ ! -d "$_sr" ]; then
        _error "store [$_sr] is a dangling or invalid symlink"
        return 1
    fi
    if [ -d "$_sr" ]; then
        (cd "$_sr" 2>/dev/null && pwd -P) || {
            _error "store [$_sr] is not accessible"
            return 1
        }
    else
        case $_sr in
            /*) printf '%s\n' "$_sr" ;;
            *) printf '%s/%s\n' "$(pwd -P)" "$_sr" ;;
        esac
    fi
}

# The logical project .sec owns the run manifests even if its store is
# symlinked to an arbitrary physical path. Match the discovered store to the
# selected canonical store before returning the project's .sec directory:
# an explicit override must never pair another store with this project's run.
_project_sec_dir() {
    _ps_selected=$(_root) || return 1
    if _ps_store=$(_find_project_store); then
        _ps_resolved=$(cd "$_ps_store" 2>/dev/null && pwd -P) || return 1
        [ "$_ps_resolved" = "$_ps_selected" ] || {
            _error "selected store [$_ps_selected] is not the current project's store"
            return 1
        }
        _ps_sec=${_ps_store%/store}
        (cd "$_ps_sec" 2>/dev/null && pwd -P) || {
            _error "project .sec [$_ps_sec] is not accessible"
            return 1
        }
    else
        _ps_rc=$?
        [ "$_ps_rc" -eq 1 ] || return 1
        _error "selected store [$_ps_selected] has no associated project .sec/store"
        return 1
    fi
}


# The container is the logical parent of store/, not necessarily the parent of
# its physical destination (when store/ itself is a symlink).
_personal_container() {
    printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/sec"
}

_container() {
    _ct_store=$(_root) || return 1
    # sec-run pins the physical store but preserves its logical container.
    if [ -n "${SEC_STORE_CONTEXT_ROOT:-}" ]; then
        _ct_candidate=$SEC_STORE_CONTEXT_ROOT
        [ -d "$_ct_candidate" ] && [ -d "$_ct_candidate/store" ] || {
            _error "invalid store context [$_ct_candidate]"; return 1;
        }
        _ct_actual=$(cd "$_ct_candidate/store" && pwd -P) || return 1
        [ "$_ct_actual" = "$_ct_store" ] || {
            _error 'store context does not match selected store'; return 1;
        }
        (cd "$_ct_candidate" && pwd -P)
        return
    fi
    if [ "${SEC_STORE_DIR+x}" = x ]; then
        # In the new layout an explicit store must be selected through its
        # logical store/ pathname; physical symlinks are fine.
        case ${SEC_STORE_DIR%/} in
            */store) _ct_candidate=${SEC_STORE_DIR%/store} ;;
            *) _error 'SEC_STORE_DIR must point to a container/store directory'; return 1 ;;
        esac
        [ -d "$_ct_candidate" ] || { _error "missing store container [$_ct_candidate]"; return 1; }
        (cd "$_ct_candidate" && pwd -P)
        return
    fi
    if _ct_project=$(_find_project_store); then
        _ct_candidate=${_ct_project%/store}
        (cd "$_ct_candidate" && pwd -P)
    else
        _ct_rc=$?
        [ "$_ct_rc" -eq 1 ] || return 1
        _ct_candidate=$(_personal_container) || return 1
        # A personal container/store symlink is permitted, as for projects.
        [ -d "$_ct_candidate" ] || {
            _error "personal store container [$_ct_candidate] does not exist; run 'sec store init'"
            return 1
        }
        (cd "$_ct_candidate" && pwd -P)
    fi
}

_cmd_root() {
    [ "$#" -eq 0 ] || { _error 'usage: sec store root'; return 1; }
    _container
}

_store_source() {
    if [ "${SEC_STORE_DIR+x}" = x ]; then
        printf 'explicit\n'
    elif _ss_project=$(_find_project_store); then
        printf 'project\n'
    else
        _ss_rc=$?
        [ "$_ss_rc" -eq 1 ] || return 1
        [ "${SEC_STORE_REQUIRE_PROJECT:-0}" != 1 ] || {
            _error 'no .sec/store found; project store required'
            return 1
        }
        printf 'personal\n'
    fi
}

_cmd_dir() {
    case $# in
        0) _root ;;
        1) case $1 in
               --source) _root >/dev/null && _store_source ;;
               --project-sec) _project_sec_dir ;;
               *) _error 'usage: sec store dir [--source|--project-sec]'; return 1 ;;
           esac ;;
        *) _error 'usage: sec store dir [--source|--project-sec]'; return 1 ;;
    esac
}

_require_store() {
	_rs=$(_root) || return 1
	[ -d "$_rs" ] || {
		_error "store [$_rs] does not exist; run 'sec store init'"
		return 1
	}
	[ -r "$_rs" ] && [ -x "$_rs" ] || {
		_error "store [$_rs] is not accessible"
		return 1
	}
}

_runtime_dir() {
	for _rd in "${XDG_RUNTIME_DIR:-}" /dev/shm "${TMPDIR:-/tmp}"; do
		[ -n "$_rd" ] && [ -d "$_rd" ] && [ -w "$_rd" ] && {
			printf '%s\n' "$_rd"
			return 0
		}
	done
	return 1
}

_runtime_tmp() {
	_rt=$(_runtime_dir) || return 1
	mktemp "$_rt/sec-store.XXXXXX"
}

_runtime_tmpdir() {
	_rt=$(_runtime_dir) || return 1
	mktemp -d "$_rt/sec-store.XXXXXX"
}

_same_dir_tmp() {
	_sd=$(dirname -- "$1") || return 1
	mktemp "$_sd/.sec-store.tmp.XXXXXX"
}

_normalize_name() {
	_nn=$1
	case $_nn in
		*.age) _nn=${_nn%.age} ;;
	esac

	case $_nn in
		''|/|/*|.|..|./*|../*|*/.|*/..|*/./*|*/../*|*//*)
			_error "invalid secret name [$1]"
			return 1
			;;
		.recipients|*/.recipients|.git|.git/*|*:* )
			_error "reserved secret name [$1]"
			return 1
			;;
	esac

	printf '%s\n' "$_nn"
}

# Reject symlinks in a managed secret path. This prevents a store entry from
# escaping SEC_STORE_DIR through a symlinked directory or file.
_check_path_components() {
	_cp_root=$1
	_cp_rel=$2
	_cp_cur=$_cp_root
	_cp_rest=$_cp_rel

	while :; do
		case $_cp_rest in
			*/*)
				_cp_part=${_cp_rest%%/*}
				_cp_rest=${_cp_rest#*/}
				_cp_more=1
				;;
			*)
				_cp_part=$_cp_rest
				_cp_rest=
				_cp_more=0
				;;
		esac

		_cp_cur=$_cp_cur/$_cp_part
		[ -L "$_cp_cur" ] && {
			_error "refusing symlink in store path [$_cp_cur]"
			return 1
		}

		[ "$_cp_more" -eq 1 ] || break
	done
}

_secret_path() {
	_sp_name=$(_normalize_name "$1") || return 1
	_sp_root=$(_root) || return 1
	_check_path_components "$_sp_root" "$_sp_name.age" || return 1
	printf '%s/%s.age\n' "$_sp_root" "$_sp_name"
}

_prepare_parent() {
	_pp_path=$1
	_pp_parent=$(dirname -- "$_pp_path") || return 1
	mkdir -p -- "$_pp_parent" || {
		_error "cannot create directory [$_pp_parent]"
		return 1
	}
}

_validate_secret_file() {
	_vf=$1
	[ -L "$_vf" ] && { _error "refusing symlink [$_vf]"; return 1; }
	[ -f "$_vf" ] || { _error "secret [$_vf] does not exist"; return 1; }
	[ -r "$_vf" ] || { _error "secret [$_vf] is not readable"; return 1; }
}

_is_age_file() {
	LC_ALL=C head -n 1 -- "$1" 2>/dev/null |
		grep -Fqx \
			-e '-----BEGIN AGE ENCRYPTED FILE-----' \
			-e 'age-encryption.org/v1'
}

# Print the closest .recipients policy path, or nothing when the secret uses
# sec's self-recipient fallback.
_policy_for_file() {
	_pf_file=$1
	_pf_root=$(_root) || return 1
	_pf_dir=$(dirname -- "$_pf_file") || return 1

	case $_pf_dir in
		"$_pf_root"|"$_pf_root"/*) ;;
		*) _error "path [$_pf_file] is outside the store"; return 1 ;;
	esac

	while :; do
		_pf_policy=$_pf_dir/.recipients

		if [ -L "$_pf_policy" ]; then
			_error "refusing symlink recipient policy [$_pf_policy]"
			return 1
		fi

		if [ -e "$_pf_policy" ]; then
			[ -f "$_pf_policy" ] && [ -r "$_pf_policy" ] || {
				_error "recipient policy [$_pf_policy] is not readable"
				return 1
			}
			printf '%s\n' "$_pf_policy"
			return 0
		fi

		[ "$_pf_dir" = "$_pf_root" ] && break
		_pf_dir=$(dirname -- "$_pf_dir") || return 1
	done

	return 0
}

# sec-store owns recipient policy selection. Clear any ambient core recipient
# variables before invoking sec so old shell exports cannot alter store ACLs.
_encrypt_with_policy() (
	_ewp_policy=$1
	unset SEC_RECIPIENTS SEC_RECIPIENTS_FILE

	if [ -n "$_ewp_policy" ]; then
		SEC_RECIPIENTS_FILE=$_ewp_policy
		export SEC_RECIPIENTS_FILE
	fi

	"$( _sec )" e
)

_core_decrypt() {
	"$( _sec )" d
}

_replace_cipher() {
	_rc_tmp=$1
	_rc_dst=$2

	if [ -e "$_rc_dst" ]; then
		chmod --reference="$_rc_dst" "$_rc_tmp" 2>/dev/null || {
			_rc_mode=$(stat -c '%a' -- "$_rc_dst" 2>/dev/null) || return 1
			chmod "$_rc_mode" "$_rc_tmp" || return 1
		}
	fi

	mv -f -- "$_rc_tmp" "$_rc_dst"
}

_cmd_init() {
    [ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && [ "$1" = --project ]; } || {
        _error 'usage: sec store init [--project]'
        return 1
    }
    if [ "${1:-}" = --project ]; then
        _ci_cwd=$(pwd -P) || return 1
        _ci_sec=$_ci_cwd/.sec
        if [ -L "$_ci_sec" ] || [ -e "$_ci_sec" ]; then
            [ -d "$_ci_sec" ] || {
                _error "project .sec [$_ci_sec] is not a directory (possibly a dangling symlink)"
                return 1
            }
        fi
        _ci_raw=$_ci_sec/store
    else
        _ci_raw=$(_root_raw) || return 1
    fi
    # Following a valid link during an explicit init is intentional; never
    # create directories behind a dangling link, however.
    if [ -L "$_ci_raw" ] && [ ! -d "$_ci_raw" ]; then
        _error "cannot initialize store: [$_ci_raw] is a dangling or invalid symlink"
        return 1
    fi
    if [ -e "$_ci_raw" ] && [ ! -d "$_ci_raw" ]; then
        _error "cannot initialize store: [$_ci_raw] is not a directory"
        return 1
    fi
    _ci_new=0
    [ -d "$_ci_raw" ] || _ci_new=1
    mkdir -p -- "$_ci_raw" || { _error "cannot create store [$_ci_raw]"; return 1; }
    [ "$_ci_new" -eq 0 ] || chmod 700 "$_ci_raw" || return 1
    _ci_root=$(cd "$_ci_raw" && pwd -P) || return 1
    _info "store initialized at [$_ci_root]"
}


# Public sources are declarative, one "alias source" per line. Never source/eval.
# Validate the entire file, not just the requested alias. A malformed project
# file must not silently fall back to a personal alias.
_sources_file() {
    _sf_root=$(_container) || return 1
    printf '%s/stores\n' "$_sf_root"
}

_read_alias() {
    _ra_file=$1 _ra_key=${2:-}
    [ ! -L "$_ra_file" ] || { _error "refusing symlink stores file [$_ra_file]"; return 1; }
    [ ! -e "$_ra_file" ] && return 3
    [ -f "$_ra_file" ] && [ -r "$_ra_file" ] || {
        _error "stores file [$_ra_file] is not readable"; return 1;
    }
    LC_ALL=C awk -v key="$_ra_key" '
        /^[[:space:]]*(#|$)/ { next }
        {
            if (NF != 2 || $1 !~ /^[a-z][a-z0-9_-]*$/ ||
                $2 !~ /^git\+(ssh|https):\/\// || seen[$1]++) {
                printf "sec-store: error: invalid/duplicate store declaration at %s:%d\n", FILENAME, FNR > "/dev/stderr"
                bad=1; next
            }
            if (key == "" || key == $1) print $1 " " $2
            if (key == $1) found=1
        }
        END { if (bad) exit 2; if (key != "" && !found) exit 3 }
    ' "$_ra_file"
}

_alias_source() {
    _as_alias=$1
    _as_file=$(_sources_file) || return 1
    _as_result=$(_read_alias "$_as_file" "$_as_alias")
    _as_rc=$?
    if [ "$_as_rc" -eq 0 ]; then
        printf '%s\n' "${_as_result#* }"
        return 0
    fi
    [ "$_as_rc" -eq 3 ] || return 1
    if [ "${SEC_STORE_PROJECT_ONLY:-0}" != 1 ]; then
        _as_personal=$(_personal_container) || return 1
        if [ -d "$_as_personal" ]; then
            _as_file=$(cd "$_as_personal" 2>/dev/null && pwd -P)/stores || return 1
            _as_result=$(_read_alias "$_as_file" "$_as_alias")
            _as_rc=$?
            if [ "$_as_rc" -eq 0 ]; then
                printf '%s\n' "${_as_result#* }"
                return 0
            fi
            [ "$_as_rc" -eq 3 ] || return 1
        fi
    fi
    _error "unknown store alias [$_as_alias]"
    return 1
}

_cmd_sources() {
    [ "$#" -eq 0 ] || { _error 'usage: sec store sources'; return 1; }
    _so_file=$(_sources_file) || return 1
    _so_primary=$(_read_alias "$_so_file" '')
    _so_rc=$?
    [ "$_so_rc" -eq 0 ] || [ "$_so_rc" -eq 3 ] || return 1
    [ -z "$_so_primary" ] || printf '%s\n' "$_so_primary"
    if [ "${SEC_STORE_PROJECT_ONLY:-0}" != 1 ]; then
        _so_personal=$(_personal_container) || return 1
        _so_here=$(_container) || return 1
        _so_personal=$(cd "$_so_personal" 2>/dev/null && pwd -P) || return 0
        if [ "$_so_personal" != "$_so_here" ]; then
            _so_other=$(_read_alias "$_so_personal/stores" '')
            _so_rc=$?
            [ "$_so_rc" -eq 0 ] || [ "$_so_rc" -eq 3 ] || return 1
            if [ -n "$_so_other" ]; then
                printf '%s\n' "$_so_other" | while IFS=' ' read -r _so_alias _so_url; do
                    printf '%s\n' "$_so_primary" | grep -Eq "^$_so_alias " || printf '%s %s\n' "$_so_alias" "$_so_url"
                done
            fi
        fi
    fi
}

_cmd_stores() {
    case ${1:-} in
        edit)
            [ "$#" -eq 1 ] || { _error 'usage: sec store stores edit|path'; return 1; }
            _ss_file=$(_sources_file) || return 1
            [ ! -L "$_ss_file" ] || { _error 'refusing symlink stores file'; return 1; }
            [ ! -e "$_ss_file" ] || [ -f "$_ss_file" ] || { _error 'stores path is not a file'; return 1; }
            [ -e "$_ss_file" ] || : >"$_ss_file" || return 1
            _ss_editor=$(_editor) || return 1
            "$_ss_editor" "$_ss_file"
            ;;
        path)
            [ "$#" -eq 1 ] || { _error 'usage: sec store stores edit|path'; return 1; }
            _sources_file
            ;;
        *) _error 'usage: sec store stores edit|path'; return 1 ;;
    esac
}

_remote_cache_root() {
    _rc_root=${SEC_STORE_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/sec/stores}
    [ ! -L "$_rc_root" ] || { _error "refusing symlink cache root [$_rc_root]"; return 1; }
    if [ ! -d "$_rc_root" ]; then
        mkdir -p -m 700 -- "$_rc_root" || return 1
    fi
    [ -d "$_rc_root" ] && [ -r "$_rc_root" ] && [ -w "$_rc_root" ] && [ -x "$_rc_root" ] || return 1
    _rc_physical=$(cd "$_rc_root" && pwd -P) || return 1
    # Refuse a pre-existing group/world-accessible root, even though cached
    # objects are ciphertext: store metadata and URLs may be confidential.
    _rc_perm=$(stat -c %a "$_rc_physical") || return 1
    _rc_owner=$(stat -c %u "$_rc_physical") || return 1
    [ "$_rc_owner" = "$(id -u)" ] || { _error 'remote cache root must be owned by current user'; return 1; }
    [ "$((0$_rc_perm & 077))" -eq 0 ] || { _error 'remote cache root must not be accessible by group/others'; return 1; }
    printf '%s\n' "$_rc_physical"
}

_remote_backend() {
    case $1 in
        git+ssh://*|git+https://*)
            command -v sec-store-remote-git || { _error 'install sec-store-remote-git'; return 1; } ;;
        *) _error "unsupported remote source [$1]"; return 1 ;;
    esac
}

# Snapshots are immutable after publication. Updates publish a new snapshot
# by atomically switching a small 'current' file. Existing readers retain a
# usable path even while another process updates the same alias.
_remote_resolve() (
    _rs_source=$1 _rs_update=$2
    _rs_backend=$(_remote_backend "$_rs_source") || exit 1
    _rs_base=$(_remote_cache_root) || exit 1
    _rs_id=$(printf '%s' "$_rs_source" | git hash-object --stdin) || exit 1
    _rs_parent=$_rs_base/$_rs_id
    [ ! -L "$_rs_parent" ] || { _error 'remote cache entry is a symlink'; exit 1; }
    mkdir -p -m 700 -- "$_rs_parent" || exit 1
    _rs_lock=$_rs_parent/lock
    [ ! -L "$_rs_lock" ] || { _error 'remote cache lock is a symlink'; exit 1; }
    command -v flock >/dev/null 2>&1 || { _error 'remote stores require flock'; exit 1; }
    exec 9>"$_rs_lock" || exit 1
    flock -x 9 || exit 1
    _rs_current=$_rs_parent/current
    [ ! -L "$_rs_current" ] || { _error 'remote cache current is a symlink'; exit 1; }
    _rs_version=
    if [ -f "$_rs_current" ]; then
        IFS= read -r _rs_version <"$_rs_current" || :
        case $_rs_version in
            snap.*) case ${_rs_version#snap.} in ''|*[!A-Za-z0-9]*) _error 'invalid remote cache pointer'; exit 1 ;; esac ;;
            *) _error 'invalid remote cache pointer'; exit 1 ;;
        esac
        [ -d "$_rs_parent/$_rs_version/store" ] && [ ! -L "$_rs_parent/$_rs_version" ] || {
            _error 'invalid remote cache snapshot'; exit 1;
        }
        "$_rs_backend" check "$_rs_source" "$_rs_parent/$_rs_version" || exit 1
    fi
    if [ -z "$_rs_version" ] || [ "$_rs_update" = 1 ]; then
        if [ "${SEC_STORE_OFFLINE:-0}" = 1 ]; then
            _error 'remote store unavailable/outdated in offline mode'; exit 1
        fi
        _rs_tmp=$(mktemp -d "$_rs_parent/.fetch.XXXXXXXX") || exit 1
        trap 'rm -rf -- "$_rs_tmp"' 0
        _rs_action=fetch
        [ "$_rs_update" != 1 ] || _rs_action=update
        "$_rs_backend" "$_rs_action" "$_rs_source" "$_rs_tmp" || exit 1
        [ -d "$_rs_tmp/store" ] && [ ! -L "$_rs_tmp/store" ] || {
            _error 'remote repository has no regular store/ directory'; exit 1;
        }
        _rs_token=${_rs_tmp##*.fetch.}
        _rs_version=snap.$_rs_token
        mv -- "$_rs_tmp" "$_rs_parent/$_rs_version" || exit 1
        _rs_tmp=
        _rs_pointer=$(mktemp "$_rs_parent/.current.XXXXXX") || exit 1
        trap 'rm -f -- "$_rs_pointer"' 0
        printf '%s\n' "$_rs_version" >"$_rs_pointer" || exit 1
        mv -f -- "$_rs_pointer" "$_rs_current" || exit 1
        _rs_pointer=
    fi
    printf '%s/store\n' "$_rs_parent/$_rs_version"
)

# A qualified entry is alias::path. Only read-only commands resolve aliases;
# the remaining commands always target the selected local/project store.
_split_entry() {
    _se_input=$1
    _se_alias= _se_entry=$_se_input
    case $_se_input in
        *::*)
            _se_alias=${_se_input%%::*}
            _se_entry=${_se_input#*::}
            case $_se_alias in ''|*[!a-z0-9_-]*|[!a-z]*) _error 'invalid store alias'; return 1 ;; esac
            [ -n "$_se_entry" ] || { _error 'missing qualified entry'; return 1; }
            ;;
        *:*) _error 'invalid entry name (use alias::entry)'; return 1 ;;
    esac
}

# Set SEC_STORE_DIR for a single read-only operation. It is deliberately
# scoped to a subshell: the caller's selected local store remains unchanged.
_with_entry_store() (
    _we_command=$1 _we_name=$2
    _split_entry "$_we_name" || exit 1
    if [ -n "$_se_alias" ]; then
        _we_source=$(_alias_source "$_se_alias") || exit 1
        SEC_STORE_DIR=$(_remote_resolve "$_we_source" 0) || exit 1
        unset SEC_STORE_CONTEXT_ROOT
        export SEC_STORE_DIR
    fi
    "$_we_command" "$_se_entry"
)

_cmd_update() {
    [ "$#" -eq 1 ] || { _error 'usage: sec store update <alias>|--all'; return 1; }
    if [ "$1" = --all ]; then
        _cu_file=$(_sources_file) || return 1
        _cu_lines=$(_read_alias "$_cu_file" '') || {
            _cu_rc=$?; [ "$_cu_rc" -eq 3 ] || return 1;
        }
        [ -n "$_cu_lines" ] || return 0
        _cu_status=0
        printf '%s\n' "$_cu_lines" | while IFS=' ' read -r _cu_alias _cu_source; do
            _remote_resolve "$_cu_source" 1 >/dev/null || exit 1
            _info "updated remote store [$_cu_alias]"
        done
        return $?
    fi
    _cu_source=$(_alias_source "$1") || return 1
    _remote_resolve "$_cu_source" 1 >/dev/null || return 1
    _info "updated remote store [$1]"
}

_cmd_put() (
	[ "$#" -ge 1 ] && [ "$#" -le 2 ] ||
		{ _error 'usage: sec store put <name> [file]'; exit 1; }

	_require_store || exit 1
	_cp_name=$1
	_cp_src=${2:-}
	_cp_path=$(_secret_path "$_cp_name") || exit 1
	_prepare_parent "$_cp_path" || exit 1

	if [ -e "$_cp_path" ] && [ ! -f "$_cp_path" ]; then
		_error "store path [$_cp_path] is not a regular file"
		exit 1
	fi

	if [ -n "$_cp_src" ]; then
		[ -f "$_cp_src" ] && [ -r "$_cp_src" ] || {
			_error "input file [$_cp_src] is not readable"
			exit 1
		}
	fi

	_cp_policy=$(_policy_for_file "$_cp_path") || exit 1
	_cp_tmp=$(_same_dir_tmp "$_cp_path") ||
		{ _error "cannot create temporary ciphertext next to [$_cp_path]"; exit 1; }
	trap 'rm -f -- "$_cp_tmp"' 0 HUP INT TERM

	_debug "put [$(_normalize_name "$_cp_name")] policy [${_cp_policy:-self}]"

	if [ -n "$_cp_src" ]; then
		_encrypt_with_policy "$_cp_policy" <"$_cp_src" >"$_cp_tmp" || {
			_error "cannot encrypt [$_cp_name]"
			exit 1
		}
	else
		_encrypt_with_policy "$_cp_policy" >"$_cp_tmp" || {
			_error "cannot encrypt [$_cp_name]"
			exit 1
		}
	fi

	_replace_cipher "$_cp_tmp" "$_cp_path" || {
		_error "cannot replace [$_cp_path]"
		exit 1
	}
	_cp_tmp=
	_info "[$(_normalize_name "$_cp_name")] stored"
)

_cmd_get() {
	[ "$#" -eq 1 ] || { _error 'usage: sec store get <name>'; return 1; }
    case $1 in *::*) _with_entry_store _cmd_get "$1"; return $? ;; esac
	_require_store || return 1

	_cg_path=$(_secret_path "$1") || return 1
	_validate_secret_file "$_cg_path" || return 1
	_is_age_file "$_cg_path" || {
		_error "secret [$1] is not age-encrypted"
		return 1
	}

	_debug "get [$(_normalize_name "$1")]"
	_core_decrypt <"$_cg_path"
}

_cmd_get1() {
	_cmd_get "$@" | head -n1 | tr -d '\n'
}

_editor() {
	printf '%s\n' "${SEC_STORE_EDITOR:-${VISUAL:-${EDITOR:-vi}}}"
}

_cmd_edit() (
	[ "$#" -eq 1 ] || { _error 'usage: sec store edit <name>'; exit 1; }
	_require_store || exit 1

	_ce_name=$(_normalize_name "$1") || exit 1
	_ce_path=$(_secret_path "$_ce_name") || exit 1
	_prepare_parent "$_ce_path" || exit 1

	if [ -e "$_ce_path" ] && [ ! -f "$_ce_path" ]; then
		_error "store path [$_ce_path] is not a regular file"
		exit 1
	fi

	_ce_dir=$(_runtime_tmpdir) ||
		{ _error 'cannot create temporary plaintext directory'; exit 1; }
	_ce_plain=$_ce_dir/secret
	_ce_cipher=$(_same_dir_tmp "$_ce_path") || {
		rm -rf -- "$_ce_dir"
		_error "cannot create temporary ciphertext next to [$_ce_path]"
		exit 1
	}
	# Cleanup on exit only. A signal trap that merely removes these paths and
	# returns can leave the shell running after the editor with no plaintext.
	trap 'rm -rf -- "$_ce_dir"; rm -f -- "$_ce_cipher"' 0
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM

	if [ -f "$_ce_path" ]; then
		_validate_secret_file "$_ce_path" || exit 1
		_is_age_file "$_ce_path" || {
			_error "secret [$_ce_name] is not age-encrypted"
			exit 1
		}
		_core_decrypt <"$_ce_path" >"$_ce_plain" || {
			_error "cannot decrypt [$_ce_name]"
			exit 1
		}
	else
		: >"$_ce_plain" || exit 1
	fi
	chmod 600 "$_ce_plain" 2>/dev/null || :

	_ce_before=$(cksum <"$_ce_plain") || exit 1
	_ce_editor=$(_editor) || exit 1
	"$_ce_editor" "$_ce_plain"
	_ce_erc=$?
	[ "$_ce_erc" -eq 0 ] || {
		_error "editor exited with status $_ce_erc"
		exit "$_ce_erc"
	}

	# Detect editors that have moved/removed the temporary file instead of
	# letting a shell redirection fail with a misleading diagnostic.
	[ -f "$_ce_plain" ] && [ ! -L "$_ce_plain" ] || {
		_error "edited temporary file disappeared [$_ce_name]; secret was not updated"
		exit 1
	}
	_ce_after=$(cksum <"$_ce_plain") || {
		_error "cannot read edited temporary file [$_ce_name]"
		exit 1
	}
	if [ "$_ce_before" = "$_ce_after" ]; then
		_info "[$_ce_name] unchanged"
		exit 0
	fi

	_ce_policy=$(_policy_for_file "$_ce_path") || exit 1
	[ -f "$_ce_plain" ] && [ ! -L "$_ce_plain" ] || {
		_error "edited temporary file disappeared before encryption [$_ce_name]; secret was not updated"
		exit 1
	}
	_encrypt_with_policy "$_ce_policy" <"$_ce_plain" >"$_ce_cipher" || {
		_error "cannot encrypt [$_ce_name]"
		exit 1
	}

	_replace_cipher "$_ce_cipher" "$_ce_path" || {
		_error "cannot replace [$_ce_path]"
		exit 1
	}
	_ce_cipher=
	_info "[$_ce_name] stored"
)

_list_under() {
	_lu_base=$1
	_lu_root=$(_root) || return 1
	_lu_prefix=$_lu_root/

	find "$_lu_base" \
		\( -path "$_lu_root/.git" -o -path "$_lu_root/.git/*" \) -prune -o \
		-type f -name '*.age' -print 2>/dev/null |
		while IFS= read -r _lu_file; do
			_lu_rel=${_lu_file#"$_lu_prefix"}
			printf '%s\n' "${_lu_rel%.age}"
		done |
		LC_ALL=C sort
}

_cmd_ls() {
	[ "$#" -le 1 ] || { _error 'usage: sec store ls [prefix|alias::[prefix]]'; return 1; }
    case ${1:-} in
        *::*)
            _cl_alias=${1%%::*} _cl_rem=${1#*::}
            _cl_source=$(_alias_source "$_cl_alias") || return 1
            _cl_remote=$(_remote_resolve "$_cl_source" 0) || return 1
            if [ -n "$_cl_rem" ]; then
                _cl_list=$(SEC_STORE_DIR=$_cl_remote SEC_STORE_CONTEXT_ROOT= "$0" ls "$_cl_rem") || return 1
                [ -z "$_cl_list" ] || printf '%s\n' "$_cl_list" | sed "s|^|$_cl_alias::|"
            else
                _cl_list=$(SEC_STORE_DIR=$_cl_remote SEC_STORE_CONTEXT_ROOT= "$0" ls) || return 1
                [ -z "$_cl_list" ] || printf '%s\n' "$_cl_list" | sed "s|^|$_cl_alias::|"
            fi
            return $?
            ;;
    esac
	_require_store || return 1

	_cl_root=$(_root) || return 1

	if [ "$#" -eq 0 ]; then
		_list_under "$_cl_root"
		return
	fi

	_cl_name=$(_normalize_name "$1") || return 1
	_cl_secret=$(_secret_path "$_cl_name") || return 1
	if [ -f "$_cl_secret" ]; then
		printf '%s\n' "$_cl_name"
		return 0
	fi

	_cl_dir=$_cl_root/$_cl_name
	_check_path_components "$_cl_root" "$_cl_name" || return 1
	[ -d "$_cl_dir" ] || {
		_error "no secret or prefix [$1]"
		return 1
	}
	_list_under "$_cl_dir"
}

_cmd_rm() {
	[ "$#" -gt 0 ] || { _error 'usage: sec store rm <name> [<name> ...]'; return 1; }
	_require_store || return 1

	_cr_rc=0
	for _cr_name do
		_cr_path=$(_secret_path "$_cr_name") || { _cr_rc=1; continue; }
		if _validate_secret_file "$_cr_path"; then
			rm -f -- "$_cr_path" && _info "[$(_normalize_name "$_cr_name")] removed" ||
				{ _error "cannot remove [$_cr_name]"; _cr_rc=1; }
		else
			_cr_rc=1
		fi
	done
	return "$_cr_rc"
}

_cmd_policy() {
	[ "$#" -eq 1 ] || { _error 'usage: sec store policy <name>'; return 1; }
    case $1 in *::*) _with_entry_store _cmd_policy "$1"; return $? ;; esac
	_require_store || return 1

	_cpo_path=$(_secret_path "$1") || return 1
	_cpo_policy=$(_policy_for_file "$_cpo_path") || return 1
	if [ -n "$_cpo_policy" ]; then
		printf '%s\n' "$_cpo_policy"
	else
		printf '%s\n' self
	fi
}

_rekey_file() (
	_rf_file=$1
	_validate_secret_file "$_rf_file" || exit 1
	_is_age_file "$_rf_file" || {
		_error "secret [$_rf_file] is not age-encrypted"
		exit 1
	}

	_rf_policy=$(_policy_for_file "$_rf_file") || exit 1
	_rf_tmp=$(_same_dir_tmp "$_rf_file") ||
		{ _error "cannot create temporary ciphertext next to [$_rf_file]"; exit 1; }
	_rf_dir=$(_runtime_tmpdir) || {
		rm -f -- "$_rf_tmp"
		_error 'cannot create temporary rekey directory'
		exit 1
	}
	_rf_fifo=$_rf_dir/plain
	mkfifo "$_rf_fifo" || {
		rm -f -- "$_rf_tmp"
		rm -rf -- "$_rf_dir"
		_error 'cannot create rekey FIFO'
		exit 1
	}
	trap 'rm -f -- "$_rf_tmp"; rm -rf -- "$_rf_dir"' 0 HUP INT TERM

	_core_decrypt <"$_rf_file" >"$_rf_fifo" &
	_rf_dec_pid=$!

	_encrypt_with_policy "$_rf_policy" <"$_rf_fifo" >"$_rf_tmp"
	_rf_enc_rc=$?

	wait "$_rf_dec_pid"
	_rf_dec_rc=$?

	if [ "$_rf_dec_rc" -ne 0 ] || [ "$_rf_enc_rc" -ne 0 ]; then
		_error "cannot rekey [$_rf_file]"
		exit 1
	fi

	_replace_cipher "$_rf_tmp" "$_rf_file" || {
		_error "cannot replace [$_rf_file]"
		exit 1
	}
	_rf_tmp=
)

_collect_secrets() {
	_cs_target=${1:-}
	_cs_out=$2
	_cs_root=$(_root) || return 1
	: >"$_cs_out" || return 1

	if [ -z "$_cs_target" ]; then
		find "$_cs_root" \
			\( -path "$_cs_root/.git" -o -path "$_cs_root/.git/*" \) -prune -o \
			-type f -name '*.age' -print >"$_cs_out" || return 1
		return 0
	fi

	_cs_name=$(_normalize_name "$_cs_target") || return 1
	_cs_secret=$(_secret_path "$_cs_name") || return 1
	if [ -f "$_cs_secret" ]; then
		printf '%s\n' "$_cs_secret" >"$_cs_out"
		return 0
	fi

	_cs_dir=$_cs_root/$_cs_name
	_check_path_components "$_cs_root" "$_cs_name" || return 1
	[ -d "$_cs_dir" ] || {
		_error "no secret or prefix [$_cs_target]"
		return 1
	}
	find "$_cs_dir" \
		\( -path "$_cs_root/.git" -o -path "$_cs_root/.git/*" \) -prune -o \
		-type f -name '*.age' -print >"$_cs_out" || return 1
}

_cmd_rekey() (
	[ "$#" -le 1 ] || { _error 'usage: sec store rekey [prefix]'; exit 1; }
	_require_store || exit 1

	_ck_list=$(_runtime_tmp) || { _error 'cannot create temporary secret list'; exit 1; }
	trap 'rm -f -- "$_ck_list"' 0 HUP INT TERM
	_collect_secrets "${1:-}" "$_ck_list" || exit 1

	_ck_rc=0
	_ck_count=0
	while IFS= read -r _ck_file || [ -n "$_ck_file" ]; do
		[ -n "$_ck_file" ] || continue
		_ck_count=$((_ck_count + 1))
		if _rekey_file "$_ck_file"; then
			_ck_root=$(_root)
			_ck_rel=${_ck_file#"$_ck_root"/}
			_info "[${_ck_rel%.age}] rekeyed"
		else
			_ck_rc=1
		fi
	done <"$_ck_list"

	[ "$_ck_count" -gt 0 ] || _info 'no secrets to rekey'
	exit "$_ck_rc"
)

_validate_policy() {
	_vp=$1
	[ -L "$_vp" ] && { _error "recipient policy [$_vp] is a symlink"; return 1; }
	[ -f "$_vp" ] && [ -r "$_vp" ] || {
		_error "recipient policy [$_vp] is not readable"
		return 1
	}

	# Let age validate the full recipient-file grammar.
	_encrypt_with_policy "$_vp" </dev/null >/dev/null
}

_cmd_check() (
	[ "$#" -eq 0 ] || { _error 'usage: sec store check'; exit 1; }
	_require_store || exit 1
	_ch_root=$(_root) || exit 1
	_ch_list=$(_runtime_tmp) || { _error 'cannot create temporary check list'; exit 1; }
	trap 'rm -f -- "$_ch_list"' 0 HUP INT TERM

	_ch_rc=0
	_ch_ok=0
	_ch_warn=0

	# Git metadata is deliberately outside sec-store's security model.
	find "$_ch_root" \
		\( -path "$_ch_root/.git" -o -path "$_ch_root/.git/*" \) -prune -o \
		\( -type l -o -type f \) -print >"$_ch_list" || exit 1

	while IFS= read -r _ch_file || [ -n "$_ch_file" ]; do
		[ -n "$_ch_file" ] || continue
		_ch_rel=${_ch_file#"$_ch_root"/}

		if [ -L "$_ch_file" ]; then
			printf 'ERROR  %s  symlink in store\n' "$_ch_rel"
			_ch_rc=1
			continue
		fi

		case $_ch_rel in
			.recipients|*/.recipients)
				if _validate_policy "$_ch_file" >/dev/null 2>&1; then
					printf 'OK     %s  recipient policy\n' "$_ch_rel"
					_ch_ok=$((_ch_ok + 1))
				else
					printf 'ERROR  %s  invalid recipient policy\n' "$_ch_rel"
					_ch_rc=1
				fi
				;;
			*.age)
				if ! _is_age_file "$_ch_file"; then
					printf 'ERROR  %s  invalid age ciphertext\n' "$_ch_rel"
					_ch_rc=1
				elif [ -n "${SEC_STORE_CHECK_DECRYPT:-}" ]; then
					if _core_decrypt <"$_ch_file" >/dev/null 2>&1; then
						printf 'OK     %s\n' "$_ch_rel"
						_ch_ok=$((_ch_ok + 1))
					else
						printf 'WARN   %s  not decryptable by current identities\n' "$_ch_rel"
						_ch_warn=$((_ch_warn + 1))
					fi
				else
					printf 'OK     %s\n' "$_ch_rel"
					_ch_ok=$((_ch_ok + 1))
				fi
				;;
			*)
				printf 'ERROR  %s  plaintext/unmanaged file in store\n' "$_ch_rel"
				_ch_rc=1
				;;
		esac
	done <"$_ch_list"

	_debug "check: $_ch_ok ok, $_ch_warn warnings"
	exit "$_ch_rc"
)


_cmd_git() {
	_require_store || return 1
	command -v git >/dev/null 2>&1 || {
		_error 'git not found'
		return 1
	}

	_cgit_root=$(_root) || return 1
	if [ "$#" -eq 0 ]; then
		set -- status
	fi

	_debug "git -C [$_cgit_root] $*"
	git -C "$_cgit_root" "$@"
}

main() {
	[ "$#" -gt 0 ] || { usage; exit 0; }
	_m_cmd=$1
	shift

	case $_m_cmd in
		init)   _cmd_init "$@" ;;
		dir)    _cmd_dir "$@" ;;
        root)   _cmd_root "$@" ;;
        stores) _cmd_stores "$@" ;;
        sources) _cmd_sources "$@" ;;
        update) _cmd_update "$@" ;;
		put)    _cmd_put "$@" ;;
		get)    _cmd_get "$@" ;;
		get1)   _cmd_get1 "$@" ;;
		edit)   _cmd_edit "$@" ;;
		ls)     _cmd_ls "$@" ;;
		rm)     _cmd_rm "$@" ;;
		policy) _cmd_policy "$@" ;;
		rekey)  _cmd_rekey "$@" ;;
		check)  _cmd_check "$@" ;;
		git|g)  _cmd_git "$@" ;;
		help|-h|--help) usage ;;
		*)
			if command -v "sec-store-$_m_cmd" >/dev/null 2>&1; then
				"sec-store-$_m_cmd" "$@"
			else
				_error "unknown command [$_m_cmd]"
				usage >&2
				exit 1
			fi
			;;
	esac
}

main "$@"
